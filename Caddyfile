web.phren.dev {
	# Không cho công cụ tìm kiếm index (2 lớp: header + robots.txt)
	header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"

	handle /robots.txt {
		respond `User-agent: *
Disallow: /
` 200
	}

	handle {
		reverse_proxy web:80
	}

	encode gzip
}

# Hub phren.dev: mỗi sản phẩm khác (reperi.phren.dev, murmr.phren.dev, ...) tự thả file <tên>.caddy vào
# /opt/phren-hub/sites trên VPS (thư mục này được mount vào container, xem docker-compose.prod.yml),
# nên thêm sản phẩm mới không phải sửa file này.
import /etc/caddy/sites/*.caddy
