web.phren.dev {
	# Không cho công cụ tìm kiếm index (2 lớp: header + robots.txt)
	header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"

	handle /robots.txt {
		respond `User-agent: *
Disallow: /
` 200
	}

	handle {
		reverse_proxy web:80
	}

	encode gzip
}

# Trang giới thiệu Reperi (repo trvux/reperi). Container reperiweb nằm ở /opt/reperiweb, tự nối vào mạng
# web-phren_default nên Caddy gọi được theo tên. Khác web.phren.dev: cho công cụ tìm kiếm index.
reperi.phren.dev {
	encode gzip
	reverse_proxy reperiweb:8090
}
